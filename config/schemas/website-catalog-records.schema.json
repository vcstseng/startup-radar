{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Startup Radar derived website records 1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","dataset_id","record_count","records"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "dataset_id":{"type":"string","minLength":1},
    "record_count":{"type":"integer","minimum":1},
    "records":{"type":"array","items":{"$ref":"#/$defs/record"}}
  },
  "$defs":{
    "tags":{"type":"object","additionalProperties":false,"required":["industry_customer","problem_workflow","solution"],"properties":{"industry_customer":{"$ref":"#/$defs/stringArray"},"problem_workflow":{"$ref":"#/$defs/stringArray"},"solution":{"$ref":"#/$defs/stringArray"}}},
    "stringArray":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "categories":{"type":"object","additionalProperties":false,"required":["industry_customer","problem_workflow","solution"],"properties":{"industry_customer":{"$ref":"#/$defs/groups"},"problem_workflow":{"$ref":"#/$defs/groups"},"solution":{"$ref":"#/$defs/groups"}}},
    "groups":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "status":{"enum":["missing","unmapped","partial","mapped"]},
    "record":{
      "type":"object","additionalProperties":false,
      "required":["id","name","summary_zh","source","website","website_status","tags","normalized_tags","categories","classification_status","detail_file"],
      "properties":{
        "id":{"type":"string","pattern":"^upstream-[0-9]{5}$"},
        "name":{"type":"string"},
        "summary_zh":{"type":["string","null"]},
        "source":{"enum":["500","alchemist","antler","ef","plugandplay","techstars","yc"]},
        "website":{"type":["string","null"],"pattern":"^https?://"},
        "website_status":{"enum":["provided_unverified","missing","invalid","shared_source"]},
        "tags":{"$ref":"#/$defs/tags"},
        "normalized_tags":{"$ref":"#/$defs/tags"},
        "categories":{"$ref":"#/$defs/categories"},
        "classification_status":{"type":"object","additionalProperties":false,"required":["industry_customer","problem_workflow","solution"],"properties":{"industry_customer":{"$ref":"#/$defs/status"},"problem_workflow":{"$ref":"#/$defs/status"},"solution":{"$ref":"#/$defs/status"}}},
        "detail_file":{"type":"string","pattern":"^details/batch-[0-9]{3}\\.json$"}
      }
    }
  }
}
