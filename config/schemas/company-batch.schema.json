{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Startup Radar lightweight company batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "round", "source_file", "companies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "round": {"type": "integer", "minimum": 1},
    "source_file": {"type": "string", "minLength": 1},
    "companies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "summary_zh", "tags", "evidence", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^upstream-[0-9]{5}$"},
          "name": {"type": "string", "minLength": 1},
          "summary_zh": {"type": ["string", "null"], "minLength": 1},
          "tags": {
            "type": "object",
            "additionalProperties": false,
            "required": ["industry_customer", "problem_workflow", "solution"],
            "properties": {
              "industry_customer": {"$ref": "#/$defs/tags"},
              "problem_workflow": {"$ref": "#/$defs/tags"},
              "solution": {"$ref": "#/$defs/tags"}
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "text"],
            "properties": {
              "field": {"enum": ["description", "location"]},
              "text": {"type": "string"}
            }
          },
          "notes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "tags": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
